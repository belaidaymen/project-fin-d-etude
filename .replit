modules = ["nodejs-20", "web", "php-8.2", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3306
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd snipe-it-next && npm install && npx prisma generate && NEXTAUTH_URL=https://$REPLIT_DEV_DOMAIN npm run dev -- -p 5000 -H 0.0.0.0"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["bash", "/home/runner/workspace/start.sh"]

[userenv]

[userenv.shared]
SUPABASE_DATABASE_URL = "postgresql://postgres.uxxgcyapmdkvdvjgbsqf:ghjkLa159.23@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
