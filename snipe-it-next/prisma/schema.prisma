generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LOGISTIQUE
  MAGASINIER
  LABORATOIRE
}

model User {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  username    String  @unique
  email       String  @unique
  password    String
  role        Role    @default(LOGISTIQUE)
  jobTitle    String?
  phone       String?
  activated   Boolean @default(true)

  laboratoireId String?
  laboratoire   Location? @relation("LabManagerUser", fields: [laboratoireId], references: [id])

  equipmentRequests EquipmentRequest[] @relation("Requester")
  reviewedRequests  EquipmentRequest[] @relation("Reviewer")
  mouvements        EquipmentMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Location {
  id      String  @id @default(cuid())
  name    String
  type    String  @default("LOCATION")
  address String?
  notes   String?

  parentId String?
  parent   Location?  @relation("LocationParent", fields: [parentId], references: [id])
  children Location[] @relation("LocationParent")

  labManagers    User[]             @relation("LabManagerUser")
  assets         Asset[]
  requests       EquipmentRequest[]
  mouvementsFrom EquipmentMovement[] @relation("MoveFrom")
  mouvementsTo   EquipmentMovement[] @relation("MoveTo")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("locations")
}

model Category {
  id    String  @id @default(cuid())
  name  String
  notes String?

  assets Asset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

model Statuslabel {
  id    String  @id @default(cuid())
  name  String
  color String?
  notes String?

  assets Asset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("status_labels")
}

model Asset {
  id           String    @id @default(cuid())
  assetTag     String    @unique
  name         String
  reference    String?
  serial       String?
  purchaseDate DateTime?
  purchaseCost Decimal?  @db.Decimal(10, 2)
  notes        String?
  quantity     Int       @default(1)

  categoryId String?
  locationId String?
  statusId   String?

  category Category?    @relation(fields: [categoryId], references: [id])
  location Location?    @relation(fields: [locationId], references: [id])
  status   Statuslabel? @relation(fields: [statusId], references: [id])

  mouvements EquipmentMovement[]
  actionlogs Actionlog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("assets")
}

model EquipmentRequest {
  id          String  @id @default(cuid())
  title       String
  description String?
  quantity    Int     @default(1)
  urgency     String  @default("NORMALE")
  status      String  @default("EN_ATTENTE")

  requesterId   String
  requester     User      @relation("Requester", fields: [requesterId], references: [id])
  laboratoireId String?
  laboratoire   Location? @relation(fields: [laboratoireId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("equipment_requests")
}

model EquipmentMovement {
  id        String  @id @default(cuid())
  type      String
  quantity  Int     @default(1)
  reference String?
  note      String?

  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id])
  fromLocationId String?
  fromLocation   Location? @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location? @relation("MoveTo", fields: [toLocationId], references: [id])

  doneById String
  doneBy   User   @relation(fields: [doneById], references: [id])

  createdAt DateTime @default(now())

  @@map("equipment_movements")
}

model Actionlog {
  id         String  @id @default(cuid())
  actionType String
  note       String?
  assetId    String?
  asset      Asset?  @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())

  @@map("action_logs")
}

model Setting {
  id       Int    @id @default(autoincrement())
  siteName String @default("GestActif")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
