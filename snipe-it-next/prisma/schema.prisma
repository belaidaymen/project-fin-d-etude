generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LOGISTICIEN
  MAGASINIER
  CHEF_LABO
}

enum TypeLocalisation {
  SALLE
  LABORATOIRE
  SERVICE
  ENTREPOT
}

enum EtatEquipement {
  BON
  MOYEN
  MAUVAIS
  HORS_SERVICE
  EN_MAINTENANCE
  REFORME
}

enum TypeMouvement {
  ENTREE
  SORTIE
  TRANSFERT
  RETOUR
}

enum TypeMaintenance {
  PREVENTIVE
  CORRECTIVE
  REVISION
}

enum StatutMaintenance {
  EN_COURS
  TERMINEE
  ANNULEE
}

enum TypeDemande {
  ACHAT
  REMPLACEMENT
  REFORME
  MAINTENANCE
}

enum Priorite {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutDemande {
  EN_ATTENTE
  EN_COURS
  APPROUVEE
  REJETEE
  CLOTUREE
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(MAGASINIER)
  actif     Boolean  @default(true)
  telephone String?
  notes     String?

  localisationId Int?
  localisation   Localisation? @relation("UserLocalisation", fields: [localisationId], references: [id])

  affectationsCreees Affectation[]
  mouvementsCreees   Mouvement[]
  demandesCreees     Demande[]
  demandesValidees   Demande[]     @relation("DemandeValidateur")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Categorie {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  description String?
  equipements Equipement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("categories")
}

model Fournisseur {
  id          Int          @id @default(autoincrement())
  nom         String
  contact     String?
  email       String?
  telephone   String?
  adresse     String?
  notes       String?
  equipements Equipement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("fournisseurs")
}

model Localisation {
  id          Int              @id @default(autoincrement())
  nom         String
  type        TypeLocalisation @default(SALLE)
  batiment    String?
  etage       String?
  capacite    Int?
  description String?
  actif       Boolean          @default(true)

  users                 User[]        @relation("UserLocalisation")
  affectations          Affectation[]
  mouvementsSource      Mouvement[]   @relation("MouvementSource")
  mouvementsDestination Mouvement[]   @relation("MouvementDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("localisations")
}

model Equipement {
  id              Int            @id @default(autoincrement())
  reference       String         @unique
  nom             String
  description     String?
  categorieId     Int
  categorie       Categorie      @relation(fields: [categorieId], references: [id])
  marque          String?
  modele          String?
  numeroSerie     String?
  etat            EtatEquipement @default(BON)
  dateAcquisition DateTime?
  prixAcquisition Float?
  fournisseurId   Int?
  fournisseur     Fournisseur?   @relation(fields: [fournisseurId], references: [id])
  quantite        Int            @default(1)
  notes           String?

  affectations Affectation[]
  mouvements   Mouvement[]
  maintenances Maintenance[]
  demandes     Demande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("equipements")
}

model Affectation {
  id              Int          @id @default(autoincrement())
  equipementId    Int
  equipement      Equipement   @relation(fields: [equipementId], references: [id])
  localisationId  Int
  localisation    Localisation @relation(fields: [localisationId], references: [id])
  quantite        Int          @default(1)
  dateAffectation DateTime     @default(now())
  dateFin         DateTime?
  notes           String?
  actif           Boolean      @default(true)
  createdParId    Int
  createdPar      User         @relation(fields: [createdParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("affectations")
}

model Mouvement {
  id            Int           @id @default(autoincrement())
  equipementId  Int
  equipement    Equipement    @relation(fields: [equipementId], references: [id])
  type          TypeMouvement
  quantite      Int           @default(1)
  dateOperation DateTime      @default(now())
  motif         String?
  notes         String?
  sourceId      Int?
  source        Localisation? @relation("MouvementSource", fields: [sourceId], references: [id])
  destinationId Int?
  destination   Localisation? @relation("MouvementDestination", fields: [destinationId], references: [id])
  createdParId  Int
  createdPar    User          @relation(fields: [createdParId], references: [id])

  createdAt DateTime @default(now())

  @@map("mouvements")
}

model Maintenance {
  id           Int               @id @default(autoincrement())
  equipementId Int
  equipement   Equipement        @relation(fields: [equipementId], references: [id])
  type         TypeMaintenance   @default(PREVENTIVE)
  description  String
  dateDebut    DateTime          @default(now())
  dateFin      DateTime?
  cout         Float?
  statut       StatutMaintenance @default(EN_COURS)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenances")
}

model Demande {
  id            Int           @id @default(autoincrement())
  type          TypeDemande
  titre         String
  description   String
  priorite      Priorite      @default(NORMALE)
  statut        StatutDemande @default(EN_ATTENTE)
  createdParId  Int
  createdPar    User          @relation(fields: [createdParId], references: [id])
  equipementId  Int?
  equipement    Equipement?   @relation(fields: [equipementId], references: [id])
  quantite      Int?
  justification String?
  notes         String?
  validateParId Int?
  validatePar   User?         @relation("DemandeValidateur", fields: [validateParId], references: [id])
  dateValidation DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("demandes")
}

model Setting {
  id           Int     @id @default(autoincrement())
  siteName     String  @default("GestActifs")
  siteSubtitle String? @default("Gestion des Actifs Universitaires")
  logoUrl      String?
  primaryColor String  @default("#3c8dbc")
  currency     String  @default("DZD")
  timezone     String  @default("Africa/Algiers")
  perPage      Int     @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
